{
  "manifest_version": 3,
  "name": "Sift",
  "version": "0.2.0",
  "description": "AI 标签管家 —— 语义自动分组、智能清理、对话式整理、归档不丢，配合 Chrome 垂直标签栏使用",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "alarms",
    "favicon",
    "scripting"
  ],
  "optional_permissions": [
    "history",
    "bookmarks",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src * data: blob:;"
  },
  "action": {
    "default_title": "Sift"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Command+Shift+E"
      },
      "description": "打开 Sift 面板"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/orb.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["orb.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  }
}
